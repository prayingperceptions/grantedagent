# --- Core ---
DATABASE_URL=postgresql+psycopg://granted:granted@localhost:5432/granted

# development | production. Production disables /api/docs and /api/openapi.json.
ENVIRONMENT=development

# Host header allow-list. Values are derived from PUBLIC_BASE_URL,
# FRONTEND_BASE_URL and API_BASE_URL; add extra hostnames here (comma
# separated). Leaving this empty in production means the derived hosts are the
# only ones accepted, which is the intended behaviour.
ALLOWED_HOSTS=

# Origins used when building absolute links (emails, billing redirects) and to
# derive the Host allow-list. Set these to the real domains in production.
PUBLIC_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# ALL, or a comma separated list of state codes: WI    |    WI,MN,CA
STATES_FILTER=ALL

# --- Federal: grants.gov (no key required) ---
GRANTS_GOV_API=https://api.grants.gov/v1/api/search2
GRANTS_GOV_ROWS=100
GRANTS_GOV_MAX_PAGES=20
GRANTS_GOV_STATUSES=forecasted|posted

# --- Simpler Grants (api.simpler.grants.gov) ---
# Public endpoints require a key; source self-disables when unset.
SIMPLER_GRANTS_API=https://api.simpler.grants.gov/v1/opportunities/search
SIMPLER_GRANTS_API_KEY=
SIMPLER_GRANTS_PAGE_SIZE=100
SIMPLER_GRANTS_MAX_PAGES=5

# --- SAM.gov opportunities ---
# Self-disables when unset.
SAM_GOV_API=https://api.sam.gov/opportunities/v2/search
SAM_GOV_API_KEY=
SAM_GOV_MAX_PAGES=5

# --- Foundations / state scrapers ---
FOUNDATIONS_USE_PLAYWRIGHT=true
FOUNDATIONS_MAX_CONCURRENCY=8
STATES_MAX_CONCURRENCY=6

# --- Scheduler ---
SCHEDULER_INTERVAL_HOURS=6
SCHEDULER_RUN_ON_START=false

# --- Inner Court (private soul.md vault) ---
# Path to the soul.md that configures matching, templates and secrets.
# Defaults to ./soul.md. Gitignored - never commit it.
INNER_COURT_PATH=./soul.md
# 32-byte key (base64 or hex) encrypting vault secrets at rest. Required only
# when a soul.md declares a `secrets:` block. Generate with:
#   python -c "from inner_court.crypto import generate_key; print(generate_key())"
INNER_COURT_KEY=

# --- Scorer (semantic matching) ---
# Sentence-transformers model. Must produce 384-dim vectors to match the schema.
SCORER_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Similarity window mapped onto 0-80; scores above get the location boost.
SCORER_SIM_FLOOR=0.10
SCORER_SIM_CEIL=0.72
# Records with descriptions shorter than this are capped, not trusted.
SCORER_MIN_DESCRIPTION_CHARS=80

# --- API / SaaS ---
# Comma separated browser origins allowed to call the API (CORS_ORIGINS).
CORS_ORIGINS=http://localhost:3000
# Default nonprofit when the request does not name one (single-tenant mode).
CURRENT_NONPROFIT_ID=

# Per-IP / per-account token-bucket limits on login, signup and mail-sending
# endpoints. Leave true in production: with it off, credential stuffing and
# inbox-flooding are unthrottled.
RATE_LIMIT_ENABLED=true

# Force the Secure flag on session cookies. It is set automatically whenever
# PUBLIC_BASE_URL is https, so this is only needed for unusual deployments
# (for example TLS terminated ahead of an http-only origin).
SESSION_COOKIE_SECURE=false
# Set to share the session cookie across subdomains (e.g. .example.org).
SESSION_COOKIE_DOMAIN=

# --- Email (verification, password reset, invites) ---
# When SMTP_HOST is unset, mail is disabled and the endpoints still answer 202.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.org
SMTP_USE_TLS=true

# --- Stripe billing ---
# Billing self-disables unless both the secret key and the webhook secret are
# set. STRIPE_PRICES maps plan keys to price IDs, e.g.
#   STRIPE_PRICES={"turnkey":"price_123","growth":"price_456"}
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICES=

# --- Outbound HTTP ---
# User-Agent sent to grants.gov, SAM.gov and state portals.
USER_AGENT=GrantedAgent/1.0 (+https://grantedagent.com)
HTTP_TIMEOUT_S=30
STATES_TIMEOUT_S=45
FOUNDATIONS_TIMEOUT_S=30
